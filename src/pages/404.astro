---
import Base from "../layouts/Base.astro";
---
<Base title="Not found · pact/">
  <section class="flex flex-col gap-5 py-24">
    <p class="font-mono text-muted">$ cd {Astro.url.pathname}</p>
    <h1 class="font-display text-[clamp(28px,4vw,44px)] font-extrabold tracking-tight">No such file or directory</h1>
    <p class="text-lg text-ink-2">That page doesn't exist. <a href="/">Back to pact/</a></p>
  </section>
</Base>
